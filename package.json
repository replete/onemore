{
  "name": "onemore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @onemore/server --filter @onemore/client dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --no-bail typecheck",
    "build": "pnpm --filter @onemore/client build",
    "start": "pnpm build && NODE_ENV=production pnpm --filter @onemore/server start",
    "live": "node tools/browser/live.mjs",
    "e2e": "node tools/browser/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
